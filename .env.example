# Configuración de Firebase (Consola de Firebase → Configuración del proyecto → Tus apps → Web).
# Copia este archivo como .env (no se sube al repositorio). En GitHub Actions se pasan como secretos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=

# 1 = usar los emuladores locales (firebase emulators:start): Auth en localhost:9099 y
# Firestore en localhost:8080. Con emuladores no hacen falta las llaves reales.
VITE_FIREBASE_EMULATOR=
