# Configuración de Firebase para compilar o probar la app en tu computadora.
# Copia este archivo como apps/alumno-web/.env.local (no se sube al repositorio) y llena los
# valores de Consola de Firebase → Configuración del proyecto → Tus apps → App web.
# En GitHub Actions se pasan como secretos del repositorio (ver docs/INSTALACION.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=

# 1 = usar los emuladores locales (pnpm emuladores): Auth en localhost:9099 y Firestore en
# localhost:8080. Con emuladores no hacen falta las llaves reales (ver .env.emulador).
VITE_FIREBASE_EMULATOR=

# 1 = datos simulados en memoria, sin Firebase (en `vite dev` también con ?simulado o sin llaves).
VITE_RLP_SIMULADO=

# Ruta del sitio publicado (no es VITE_: solo la usa la compilación). Por defecto "./" (sirve en
# cualquier carpeta). El workflow de GitHub Pages pone /<repositorio>/.
# RLP_BASE=/rLearningPy/
